#![wf_tag("jurisdiction.US")]

let data_1 := new Data { name := "cancer_age_s8_p1" };
let data_2 := new Data { name := "cancer_age_s8_p3" };

#[on("participant-1")]
#[tag("identifiability.Pseudonymized")]
