import fed_mean;

#![wf_tag("sensitivity.High")]
#![wf_tag("legal_basis.consent")]
#![wf_tag("jurisdiction.EU")]

let data_1 := new Data { name := "cancer_age_s5_p1" };
let data_2 := new Data { name := "cancer_age_s5_p3" };

#[on("participant-1")]
#[tag("identifiability.Identified")]
let stats_1 := compute_local(data_1);

#[on("participant-3")]
#[tag("identifiability.Identified")]
let stats_2 := compute_local(data_2);

#[on("coordinator-5")]
let combined := combine_results(stats_1, stats_2);

#[on("coordinator-5")]
let result := finalize(combined);

return result;