#![wf_tag("jurisdiction.EU")]

let data_1 := new Data { name := "cancer_age_s4_p1" };
let data_3 := new Data { name := "cancer_age_s4_p3" };
let data_5 := new Data { name := "cancer_age_s4_p5" };
let data_7 := new Data { name := "cancer_age_s4_p7" };

#[on("participant-1")]
#[tag("identifiability.Pseudonymized")]
let stats_1 := compute_local(data_1);

#[on("participant-3")]
#[tag("identifiability.Anonymized")]
let stats_3 := compute_local(data_3);

#[on("participant-5")]
#[tag("identifiability.Pseudonymized")]
let stats_5 := compute_local(data_5);

#[on("participant-7")]
#[tag("identifiability.Anonymized")]
let stats_7 := compute_local(data_7);

#[on("coordinator-4")]
let acc_0 := combine_results(stats_1, stats_3);
#[on("coordinator-4")]
let acc_1 := combine_results(acc_0, stats_5);
#[on("coordinator-4")]
let acc_2 := combine_results(acc_1, stats_7);

#[on("coordinator-4")]
let result := finalize(acc_2);

return result;