import fed_mean;

let data_1 := new Data { name := "cancer_age_s7_p1" };
let data_2 := new Data { name := "cancer_age_s7_p3" };

#[on("participant-1")]
let stats_1 := compute_local(data_1);

#[on("participant-3")]
let stats_2 := compute_local(data_2);

#[on("coordinator-7")]
let combined := combine_results(stats_1, stats_2);

#[on("coordinator-7")]
let result := finalize(combined);

return result;