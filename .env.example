# ── Required ──────────────────────────────────────────────────────────────────

# Secret key that BraneHub and any API client must send in X-API-Key header.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
BRANE_INTEGRATOR_API_KEY=changeme

# Base URL of your BraneHub instance (leave empty to run in standalone mode
# without a governance portal — useful for local testing).
BRANEHUB_BASE_URL=http://localhost:5000

# OpenAI API key — required only when WORKFLOW_GENERATION_STRATEGY=llm or
# when using the LLM package authoring (Path A / Path B) features.
OPENAI_API_KEY=sk-...

# ── Brane filesystem paths ────────────────────────────────────────────────────
# All paths must be absolute. On WSL2, use the Linux path (e.g. /home/user/...).

# Directory that holds your Brane node configs (central/, worker1/, ...).
# Default if unset: ~/brane/nodes
BRANE_NODES_DIR=/home/youruser/brane/nodes

# Directory where Brane dataset files live (one sub-dir per dataset).
# Default if unset: ~/brane/data
BRANE_DATA_DIR=/home/youruser/brane/data

# Directory where Brane writes workflow result files.
# Default if unset: ~/brane/results
BRANE_RESULTS_DIR=/home/youruser/brane/results

# Directory where `brane package build` stores built packages (local registry).
# Default if unset: ~/.local/share/brane/packages
BRANE_PACKAGES_DIR=/home/youruser/.local/share/brane/packages

# Absolute path to the branelet binary (used with `brane package build --init`).
# A pre-compiled x86-64 Linux binary ships at bin/branelet in this repo.
# Default if unset: (branelet flag omitted — uses brane's default)
BRANELET_PATH=/absolute/path/to/repo/bin/branelet

# Path to the brane CLI binary used to execute workflows.
# Default if unset: uses "brane" from PATH.
BRANE_CLI_PATH=/usr/local/bin/brane

# Name of the central brane-api Docker container.
# Default: brane-api
BRANE_API_CONTAINER=brane-api

# Path inside the brane-api container where packages are stored.
# Used to chown the directory before pushing packages.
# Default if unset: /packages
BRANE_CENTRAL_PACKAGES_PATH=/packages

# ── Optional / tuning ─────────────────────────────────────────────────────────

# Workflow generation strategy: "map_reduce" (deterministic) or "llm".
# Default: map_reduce
WORKFLOW_GENERATION_STRATEGY=map_reduce

# OpenAI model to use for LLM generation and package authoring.
# Default: gpt-4o
OPENAI_MODEL=gpt-4o

# Brane API address (host:port) used by the workflow executor.
# Default: localhost:50051
BRANE_API_URL=localhost:50051

# Seconds before the workflow executor gives up waiting for a result.
# Default: 600
EXECUTION_TIMEOUT_SECONDS=600

# Set to true when running inside WSL2 with Docker Desktop.
# Enables the socat bridge container (brane-fwd) and extends PATH for the
# Docker Desktop CLI tools. Leave false on native Linux.
# Default: false
WSL2_MODE=false

# SQLAlchemy database URL for the Integrator's local state.
# Default: sqlite:///./integrator.db
DATABASE_URL=sqlite:///./integrator.db

# Set to true to echo all SQL statements — useful for debugging only.
# Default: false
SQL_ECHO=false
